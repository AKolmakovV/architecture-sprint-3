@startuml

title "С4 Контейнеры - Умный дом"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

top to bottom direction

Person(user, "Пользователь", "Владелец умного дома")


Enterprise_Boundary(smartHome, "Экосистема Умного Дома") {


    Container(ui, "Веб-приложение", "JavaScript/HTML/CSS", "Позволяет пользователям управлять системой")
    Container(apiGateway, "API Gateway", "Kong Gateway", "Авторизация, кеширование, маршрутизация запросов")


    Container(devicesService, "DevicesService", "Java", "API Для взаимодействия с датчиками и умными устройствами") #319439
    ContainerDb(devicesDb, "Devices DB", "PostgreSQL", "Хранение информации об устройствах")
    
    Container(telemetryService, "TelemetryService", "Java", "Сервис мониторинга и телеметрии")  #319439
    ContainerDb(telemetryDb, "Telemetry DB", "PostgreSQL", "Хранение телеметрических данных")
    
    Container(notificationService, "NotificationService", "Java", "Сервис уведомлений") #319439
    ContainerDb(notificationDb, "Notification DB", "PostgreSQL", "Хранение истории уведомлений")
    
    Container(identityService, "IdentityService", "Java", "Управление пользователями") #319439
    ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Хранение данных пользователей и ролей")

    Container(homesService, "HomesService", "Java", "Управление сценариями и домами") #319439
    ContainerDb(homesDb, "Homes DB", "PostgreSQL", "Хранит данные о пользователях c привязкой к домам, а также устройствах в доме")

    Container(supportService, "SupportService", "Java", "Сервис технической поддержки клиентов") #319439
    ContainerDb(supportDb, "Support DB", "PostgreSQL", "Запросы и консультации технической поддержки")


    SystemQueue(kafka, "Kafka", "Брокер сообщений для асинхронного взаимодействия сервисов") #232227
    

    Container(redis, "Redis", "In-Memory Cache", "Кеширование данных и ускорение запросов") #DC382D
}

System_Ext(sensors, "Датчики и прочее оборудование")


Rel(user, ui, "Взаимодействие через браузер (HTTPS)")
Rel(ui, apiGateway, "Запросы к API")

Rel(apiGateway, devicesService, "Команды устройствам")
Rel(apiGateway, telemetryService, "Запрос телеметрических данных")
Rel(apiGateway, identityService, "Аутентификация и авторизация пользователей")
Rel(apiGateway, notificationService, "Отправка уведомлений пользователям")
Rel(apiGateway, homesService, "Запрос домов пользователя")
Rel(apiGateway, supportService, "Взаимодействие с технической поддержкой")


Rel(telemetryService, devicesService, "Запрос данных реального времени")

Rel(homesService, devicesService, "Список устройств пользователя и отправка команд")
Rel(homesService, identityService, "Получает информацию о пользователе")


Rel(devicesService, sensors, "Взаимодейтсвие с устройствами по стандартным протоколам")


Rel(notificationService, kafka, "Подписка на события уведомлений")
Rel(devicesService, kafka, "Отправка событий оборудования")
Rel(telemetryService, kafka, "Отправка событий мониторинга и подписка на события оборудования")
Rel(supportService, kafka, "Уведомления тех.поддержки")


Rel(devicesService, devicesDb, "Устройства и настройки")
Rel(telemetryService, telemetryDb, "Значения телеметрии")
Rel(identityService, identityDb, "Пользователи и их параметры")
Rel(notificationService, notificationDb, "История уведомлений")
Rel(homesService, homesDb, "Дома, конфигурация, связи с пользователями, сценарии")
Rel(supportService, supportDb, "Дома, конфигурация, связи с пользователями, сценарии")


Rel(apiGateway, redis, "Кеширование данных для уменьшения нагрузки")

@enduml

